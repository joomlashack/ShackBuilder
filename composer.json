{
    "name"       : "joomlashack/shackbuilder",
    "description": "Builder scripts for Joomlashack extensions",
    "license"    : "GPL-2.0-or-later",
    "keywords"   : [
        "joomlashack",
        "builder",
        "phing"
    ],
    "homepage"   : "https://github.com/joomlashack/ShackBuilder",
    "authors"    : [
        {
            "name" : "Joomlashack",
            "email": "help@joomlashack.com"
        }
    ],
    "require"    : {
        "php"          : ">=8.4",
        "ext-dom"      : "*",
        "ext-json"     : "*",
        "ext-libxml"   : "*",
        "ext-simplexml": "*",
        "ext-xml"      : "*",
        "phing/phing"  : "^3.1"
    },
    "autoload"   : {
        "psr-4": {
            "ShackBuilder\\Tasks\\": "src/tasks/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "tedivm/jshrink": "^1.8"
    },
    "autoload-dev": {
        "psr-4": {
            "ShackBuilder\\Tests\\": "tests/"
        }
    },
    "scripts"    : {
        "test"            : "phpunit",
        "test:unit"       : "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration"
    }
}
